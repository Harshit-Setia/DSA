{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile and run java (workspace root IO)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                // 1. Change directory to the file's parent directory for compilation and class placement
                //    (e.g., C:\Users\Harshit\Desktop\DSA\practice\ETE)
                // 2. Compile the Java file (e.g., one.java)
                // 3. Run the Java class (e.g., one)
                // 4. Redirect input from the workspace root 'input.txt'
                //    (e.g., C:\Users\Harshit\Desktop\DSA\input.txt)
                // 5. Redirect output to the workspace root 'output.txt'
                //    (e.g., C:\Users\Harshit\Desktop\DSA\output.txt)
                "cd \"${fileDirname}\" && javac \"${fileBasename}\" && java \"${fileBasenameNoExtension}\" < \"${workspaceFolder}/input.txt\" > \"${workspaceFolder}/output.txt\""
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "never",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        }
    ]
}